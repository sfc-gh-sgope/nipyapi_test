# --- GitHub (optional) ---
# Only used when a flow/config file isn't found locally under flows/<bucket>/.
# Leave these unset to deploy from local files only. GITHUB_PAT isn't needed for public repos.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=sfc-gh-sgope/nipyapi_test
#GITHUB_BRANCH=feature/add-snowflake-to-postgres-flow
GITHUB_BRANCH=main
GITHUB_FLOWS_PATH=flows

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=sfsenorthamerica-sgope_aws3
SNOWFLAKE_USER=sgope
SNOWFLAKE_PAT=ver:1:xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SNOWFLAKE_ROLE=OPENFLOW_ADMIN

#ALTER USER sgope ADD PROGRAMMATIC ACCESS TOKEN NIFI_OPENFLOW_PAT
#  ROLE_RESTRICTION = OPENFLOW_ADMIN
#  DAYS_TO_EXPIRY = 365
#  COMMENT = 'PAT for OpenFlow deploy with OPENFLOW_ADMIN role';

# --- OpenFlow Runtime (default — can be overridden with --runtime flag) ---
OPENFLOW_RUNTIME=POSTGRES_DEMO

# Host prefix of the runtime URL (default: of1). Check the runtime URL in Snowsight:
#   https://of2--<org>-<account>.snowflakecomputing.app/<runtime-key>  ->  OPENFLOW_HOST_PREFIX=of2
# OPENFLOW_HOST_PREFIX=of1

# --- Private Link (optional) ---
# Set to true if your account uses AWS PrivateLink / Azure Private Link
# This changes the runtime domain from snowflakecomputing.app to privatelink.snowflakecomputing.app
# USE_PRIVATELINK=true

# --- No plain text passwords needed! ---
# Secrets are resolved from Snowflake SECRET objects via the Parameter Provider.
# Reference them in config.secure.yaml as:
#   $SF_SECRET{DATABASE.SCHEMA.SECRET_NAME}
# ex $SF_SECRET{OPENFLOW.OPENFLOW.API_POSTGRESQL}
# The script wires the Parameter Provider so NiFi resolves the value at runtime.